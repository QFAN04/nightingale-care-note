# Copy to .env only when overriding the built-in local defaults.
# Never commit real credentials.
DATABASE_URL=sqlite+pysqlite:///./nightingale.db
# For Supabase/PostgreSQL, replace DATABASE_URL locally with:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres
# DEEPSEEK_API_KEY=replace-with-your-local-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT_SECONDS=30
